{
  "name": "beerstats-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "nx run-many --targets=serve --projects=web,beerapi",
    "dev:api": "nx serve beerapi",
    "dev:web": "nx serve web",
    "build": "nx run-many --target=build --projects=web,beerapi",
    "test": "nx run-many --target=test --projects=web,beerapi",
    "test:web": "nx run web:test",
    "test:api": "nx run beerapi:test",
    "lint": "nx run-many --target=lint --projects=web,beerapi",
    "typecheck": "nx run web:typecheck",
    "deploy": "nx run web:build && gh-pages -d dist/apps/web",
    "graph": "nx graph"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "test"
        ]
      }
    }
  },
  "devDependencies": {
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "23.0.0",
    "@nx/jest": "23.0.0",
    "@nx/js": "23.0.0",
    "@nx/nest": "^23.0.0",
    "@nx/node": "23.0.0",
    "@nx/vite": "23.0.0",
    "@nx/web": "23.0.0",
    "@nx/webpack": "23.0.0",
    "@swc/helpers": "~0.5.18",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^29.5.8",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-test-renderer": "^18.0.6",
    "@types/redux-mock-store": "^1.0.6",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.2.0",
    "axios-mock-adapter": "^1.22.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "gh-pages": "^6.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-util": "^29.7.0",
    "jiti": "2.4.2",
    "nx": "23.0.0",
    "papaparse": "^5.5.3",
    "prettier": "~3.6.2",
    "redux-mock-store": "^1.5.4",
    "ts-jest": "^29.1.1",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "^5.4.5",
    "vite": "^5.0.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.18",
    "@mui/material": "^5.14.18",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@reduxjs/toolkit": "^1.9.7",
    "@types/react-redux": "^7.1.30",
    "ag-grid-community": "^35.3.1",
    "ag-grid-react": "^35.3.1",
    "axios": "^1.6.2",
    "chart.js": "^4.4.0",
    "localforage": "^1.10.0",
    "match-sorter": "^6.3.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.19.0",
    "react-test-renderer": "^18.2.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sort-by": "^1.2.0"
  }
}
